insertSeriesConnection:
INSERT OR REPLACE INTO artistSeriesConnection
VALUES ?;

insertMerchConnection:
INSERT OR REPLACE INTO artistMerchConnection
VALUES ?;

getSeries:
SELECT rowid AS rowid, * FROM seriesEntry;

insertSeries:
INSERT OR REPLACE INTO seriesEntry
VALUES ?;

getMerch:
SELECT * FROM merchEntry;

insertArtistConnection:
INSERT OR REPLACE INTO stampRallyArtistConnection
VALUES ?;

insertStampRallySeriesConnection:
INSERT OR REPLACE INTO stampRallySeriesConnection
VALUES ?;

insertStampRallyMerchConnection:
INSERT OR REPLACE INTO stampRallyMerchConnection
VALUES ?;

insertStampRallyPrizeMerchConnection:
INSERT OR REPLACE INTO stampRallyPrizeMerchConnection
VALUES ?;

insertArtistChangelogEntry:
INSERT OR REPLACE INTO artistChangelogEntry
VALUES ?;

insertStampRallyChangelogEntry:
INSERT OR REPLACE INTO stampRallyChangelogEntry
VALUES ?;

insertArtistEntryAnimeNyc2026Changelog:
INSERT OR REPLACE INTO artistEntryAnimeNyc2026Changelog
VALUES ?;

insertSeriesChangelog:
INSERT OR REPLACE INTO seriesEntryChangelog
VALUES ?;

insertMerchChangelog:
INSERT OR REPLACE INTO merchEntryChangelog
VALUES ?;

updateArtistEntry:
INSERT OR REPLACE INTO artistEntry
VALUES ?;

updateArtistEntryImages:
UPDATE artistEntry SET images = :images WHERE dataYear = :dataYear AND id = :id;

getArtistEntries:
SELECT rowid AS rowid, * FROM artistEntry;

getArtistEntriesByYear:
SELECT * FROM artistEntry
WHERE dataYear = :dataYear;

updateStampRallyEntry:
INSERT OR REPLACE INTO stampRallyEntry
VALUES ?;

updateStampRallyImages:
UPDATE stampRallyEntry SET images = :images WHERE id = :id;

getStampRallyEntries:
SELECT rowid AS rowid, * FROM stampRallyEntry;

getStampRallyEntriesByYear:
SELECT * FROM stampRallyEntry
WHERE dataYear = :dataYear;

getArtistImages:
SELECT images FROM artistEntry
WHERE dataYear = :dataYear AND id = :id;

getRowIdsByBooth:
SELECT rowid AS rowid
FROM artistEntry
WHERE dataYear = :dataYear AND booth = :booth;

updateSeriesTagCounts:
UPDATE seriesEntry SET
inferred2024 = :inferredAnimeExpo2024,
inferred2025 = :inferredAnimeExpo2025,
inferredAnimeExpo2026 = :inferredAnimeExpo2026,
inferredAnimeNyc2024 = :inferredAnimeNyc2024,
inferredAnimeNyc2025 = :inferredAnimeNyc2025,
inferredAnimeNyc2026 = :inferredAnimeNyc2026,
confirmed2024 = :confirmedAnimeExpo2024,
confirmed2025 = :confirmedAnimeExpo2025,
confirmedAnimeExpo2026 = :confirmedAnimeExpo2026,
confirmedAnimeNyc2024 = :confirmedAnimeNyc2024,
confirmedAnimeNyc2025 = :confirmedAnimeNyc2025,
confirmedAnimeNyc2026 = :confirmedAnimeNyc2026
WHERE id = :id;

updateMerchYearFlags:
UPDATE merchEntry SET yearFlags = :yearFlags WHERE name = :id;

cleanUpForRelease {
    DROP TABLE artistEntry2023;
    DROP TABLE artistEntry2024;
    DROP TABLE artistEntry2025;
    DROP TABLE artistEntryAnimeNyc2024;
    DROP TABLE artistEntryAnimeNyc2025;
    DROP TABLE artistEntryAnimeExpo2026;
    DROP TABLE artistEntryAnimeNyc2026;
    DROP TABLE stampRallyEntry2023;
    DROP TABLE stampRallyEntry2024;
    DROP TABLE stampRallyEntry2025;
    DROP TABLE stampRallyEntryAnimeExpo2026;
    UPDATE artistEntry SET status = NULL;
    UPDATE artistEntry SET editorNotes = NULL;
    UPDATE artistEntry SET lastEditor = NULL;
    UPDATE stampRallyEntry SET editorNotes = NULL;
    UPDATE stampRallyEntry SET lastEditor = NULL;
}
