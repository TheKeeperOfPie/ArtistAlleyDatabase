updateArtistEntryAnimeExpo2025Images:
UPDATE artistEntry2025 SET images = :images WHERE id = :id;

updateArtistEntryAnimeNyc2025Images:
UPDATE artistEntryAnimeNyc2025 SET images = :images WHERE id = :id;

updateStampRallyAnimeExpo2025Images:
UPDATE stampRallyEntry2025 SET images = :images WHERE id = :id;

updateArtistEntry:
INSERT OR REPLACE INTO artistEntry
VALUES ?;

updateArtistEntryImages:
UPDATE artistEntry SET images = :images WHERE dataYear = :dataYear AND id = :id;

getArtistEntries:
SELECT rowid AS rowid, * FROM artistEntry;

getArtistEntriesByYear:
SELECT * FROM artistEntry
WHERE dataYear = :dataYear;

updateStampRallyEntry:
