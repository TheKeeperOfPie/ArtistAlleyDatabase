insertArtist:
INSERT OR REPLACE INTO artistEntry
VALUES ?;

getArtistUserData:
SELECT artistEntry.id, artistUserEntry.favorite, artistUserEntry.ignored FROM artistEntry
LEFT OUTER JOIN artistUserEntry
ON artistEntry.id = artistUserEntry.artistId AND artistUserEntry.dataYear = :dataYear;

insertArtistNotes:
INSERT OR REPLACE INTO artistNotes
VALUES ?;

getArtistNotes:
SELECT artistNotes.* FROM artistNotes
ORDER BY artistNotes.artistId, artistNotes.dataYear;

getArtistUserEntries:
SELECT * FROM artistUserEntry;

insertStampRally:
INSERT OR REPLACE INTO stampRallyEntry
VALUES ?;

getStampRallyUserData:
SELECT stampRallyEntry.id, stampRallyUserEntry.favorite, stampRallyUserEntry.ignored FROM stampRallyEntry
LEFT OUTER JOIN stampRallyUserEntry
ON stampRallyEntry.id = stampRallyUserEntry.stampRallyId
WHERE stampRallyEntry.dataYear = :dataYear;

insertStampRallyNotes:
INSERT OR REPLACE INTO stampRallyNotes
VALUES ?;

getStampRallyNotes:
SELECT stampRallyNotes.* FROM stampRallyNotes
ORDER BY stampRallyNotes.stampRallyId;

getStampRallyUserEntries:
SELECT * FROM stampRallyUserEntry;

insertSeries:
INSERT OR REPLACE INTO seriesEntry
VALUES ?;

getSeriesUserEntries:
SELECT * FROM seriesUserEntry;

insertMerch:
INSERT OR REPLACE INTO merchEntry
VALUES ?;

getMerchUserEntries:
SELECT * FROM merchUserEntry;
