getArtistChangesSince:
SELECT * FROM artistUserEntry
WHERE generation > :lastSyncGeneration;

getStampRallyChangesSince:
SELECT * FROM stampRallyUserEntry
WHERE generation > :lastSyncGeneration;

getSeriesChangesSince:
SELECT * FROM seriesUserEntry
WHERE generation > :lastSyncGeneration;

getMerchChangesSince:
SELECT * FROM merchUserEntry
WHERE generation > :lastSyncGeneration;
