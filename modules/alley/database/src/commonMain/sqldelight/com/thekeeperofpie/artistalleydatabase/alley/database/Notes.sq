getArtistNotes:
SELECT * FROM artistNotes
WHERE artistId = :artistId AND dataYear = :dataYear;

getStampRallyNotes:
SELECT * FROM stampRallyNotes
WHERE stampRallyId = :stampRallyId;

insertArtistNotes:
INSERT OR REPLACE INTO artistNotes
VALUES ?;

insertStampRallyNotes:
INSERT OR REPLACE INTO stampRallyNotes
VALUES ?;
