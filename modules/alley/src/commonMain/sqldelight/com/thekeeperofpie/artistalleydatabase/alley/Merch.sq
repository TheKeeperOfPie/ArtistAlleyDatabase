getMerch:
SELECT * FROM merchEntry;

getMerchById:
SELECT merchEntry.*, merchUserEntry.favorite FROM merchEntry
LEFT OUTER JOIN merchUserEntry
ON merchEntry.uuid = merchUserEntry.merchId
WHERE name = :id;

getMerchEntries:
SELECT * FROM merchEntry
WHERE (yearFlags & :yearFlag) != 0;

getMerchSize:
SELECT COUNT(*) FROM merchEntry
WHERE (yearFlags & :yearFlag) != 0;

getBoothsByMerchId:
SELECT artistEntry.booth FROM artistMerchConnection
INNER JOIN artistEntry ON (artistMerchConnection.artistRowId = artistEntry.rowid)
WHERE artistEntry.dataYear = :dataYear
AND artistMerchConnection.merchId = :merchId
AND (artistMerchConnection.yearFlags & :yearFlag) != 0;

getMerchChangelog:
SELECT * FROM merchEntryChangelog;

getFandomMerchEntries:
SELECT * FROM merchEntry
WHERE merchEntry.name IN (
    SELECT DISTINCT(merchId) FROM stampRallyMerchConnection
    WHERE dataYear = :dataYear
);

getPrizeMerchEntries:
SELECT * FROM merchEntry
WHERE merchEntry.name IN (
    SELECT DISTINCT(merchId) FROM stampRallyPrizeMerchConnection
    WHERE dataYear = :dataYear
);
