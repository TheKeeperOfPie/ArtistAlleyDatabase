insertArtistUserEntry:
INSERT OR REPLACE INTO artistUserEntry
VALUES ?;

insertStampRallyUserEntry:
INSERT OR REPLACE INTO stampRallyUserEntry
VALUES ?;

getArtistUserEntry:
SELECT * FROM artistUserEntry
WHERE artistId = :artistId AND dataYear = :dataYear;

getBoothsWithFavorites:
SELECT artistEntry.id, artistEntry.dataYear, artistEntry.booth, artistEntry.name, artistEntry.images, artistEntry.fallbackImageYear, artistEntry.tempImages, artistEntry.embeds, artistUserEntry.favorite, artistNotes.notes FROM artistEntry
LEFT OUTER JOIN artistUserEntry
ON artistEntry.id = artistUserEntry.artistId AND artistUserEntry.dataYear = :dataYear
LEFT OUTER JOIN artistNotes
ON artistEntry.id = artistNotes.artistId AND artistNotes.dataYear = :dataYear
WHERE artistEntry.dataYear = :dataYear;

getStampRallyUserEntry:
SELECT * FROM stampRallyUserEntry
WHERE stampRallyId = :stampRallyId;

getArtistFavorites:
SELECT artistId FROM artistUserEntry
WHERE favorite = 1 AND dataYear = :dataYear;

getAllArtistFavorites:
SELECT artistId FROM artistUserEntry
WHERE favorite = 1;

getSeriesUserEntry:
SELECT * FROM seriesUserEntry
WHERE seriesId = :seriesId;

insertSeriesUserEntry:
INSERT OR REPLACE INTO seriesUserEntry
VALUES ?;

getMerchUserEntry:
SELECT * FROM merchUserEntry
WHERE merchId = :merchId;

insertMerchUserEntry:
INSERT OR REPLACE INTO merchUserEntry
VALUES ?;

getSeriesFavorites:
SELECT seriesEntry.id FROM seriesUserEntry
LEFT OUTER JOIN seriesEntry
ON seriesEntry.uuid = seriesUserEntry.seriesId
WHERE seriesUserEntry.favorite = 1;

getMerchFavorites:
SELECT merchEntry.name FROM merchUserEntry
LEFT OUTER JOIN merchEntry
ON merchEntry.uuid = merchUserEntry.merchId
WHERE merchUserEntry.favorite = 1;

getRallyFavorites:
SELECT stampRallyId FROM stampRallyUserEntry
WHERE favorite = 1;
