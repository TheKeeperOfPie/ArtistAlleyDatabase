importArtistUserEntry:
INSERT OR REPLACE INTO artistUserEntry(artistId, dataYear, favorite, ignored)
VALUES(:artistId, :dataYear, :favorite, :ignored);

importArtistNotes:
INSERT OR REPLACE INTO artistNotes(artistId, dataYear, notes)
VALUES(:artistId, :dataYear, :notes);

importStampRallyUserEntry:
INSERT OR REPLACE INTO stampRallyUserEntry(stampRallyId, favorite, ignored)
VALUES(:stampRallyId, :favorite, :ignored);

importStampRallyNotes:
INSERT OR REPLACE INTO stampRallyNotes(stampRallyId, notes)
VALUES(:stampRallyId, :notes);

getExportPartialArtists:
SELECT artistEntry.id, artistUserEntry.favorite, artistUserEntry.ignored FROM artistEntry
LEFT OUTER JOIN artistUserEntry
ON (artistEntry.id = artistUserEntry.artistId AND artistUserEntry.dataYear = :dataYear)
WHERE artistEntry.dataYear = :dataYear
ORDER BY artistEntry.id ASC;

getExportFullArtists:
SELECT artistEntry.booth, artistEntry.name, artistEntry.id, artistUserEntry.favorite, artistUserEntry.ignored, artistNotes.notes FROM artistEntry
LEFT OUTER JOIN artistUserEntry
ON (artistEntry.id = artistUserEntry.artistId AND artistUserEntry.dataYear = :dataYear)
LEFT OUTER JOIN artistNotes
ON (artistEntry.id = artistNotes.artistId AND artistNotes.dataYear = :dataYear)
WHERE artistEntry.dataYear = :dataYear
AND (artistUserEntry.favorite == 1 OR artistUserEntry.ignored == 1 OR artistNotes.notes IS NOT NULL);

getExportPartialStampRallies:
SELECT stampRallyEntry.id, stampRallyUserEntry.favorite, stampRallyUserEntry.ignored FROM stampRallyEntry
LEFT OUTER JOIN stampRallyUserEntry
ON stampRallyEntry.id = stampRallyUserEntry.stampRallyId
WHERE stampRallyEntry.dataYear = :dataYear
ORDER BY stampRallyEntry.id ASC;

getExportFullStampRallies:
SELECT stampRallyEntry.fandom, stampRallyEntry.tables, stampRallyEntry.id, stampRallyUserEntry.favorite, stampRallyUserEntry.ignored, stampRallyNotes.notes FROM stampRallyEntry
LEFT OUTER JOIN stampRallyUserEntry
ON stampRallyEntry.id = stampRallyUserEntry.stampRallyId
LEFT OUTER JOIN stampRallyNotes
ON stampRallyEntry.id = stampRallyNotes.stampRallyId
WHERE stampRallyEntry.dataYear = :dataYear
AND (stampRallyUserEntry.favorite == 1 OR stampRallyUserEntry.ignored == 1 OR stampRallyNotes.notes IS NOT NULL);

getExportFullSeries:
SELECT * FROM seriesUserEntry
WHERE seriesUserEntry.favorite = 1;

getExportFullMerch:
SELECT * FROM merchUserEntry
WHERE merchUserEntry.favorite = 1;

importSeriesUserEntry:
INSERT OR REPLACE INTO seriesUserEntry(seriesId, favorite)
VALUES(:seriesId, :favorite);

importMerchUserEntry:
INSERT OR REPLACE INTO merchUserEntry(merchId, favorite)
VALUES(:merchId, :favorite);

deleteArtistNotes:
DELETE FROM artistNotes;

deleteArtistUserEntry:
DELETE FROM artistUserEntry;

deleteStampRallyNotes:
DELETE FROM stampRallyNotes;

deleteStampRallyUserEntry:
DELETE FROM stampRallyUserEntry;

deleteSeriesUserEntry:
DELETE FROM seriesUserEntry;

deleteMerchUserEntry:
DELETE FROM merchUserEntry;
