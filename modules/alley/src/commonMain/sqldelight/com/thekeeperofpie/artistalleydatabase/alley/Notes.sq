getArtistNotes:
SELECT * FROM artistNotes
WHERE artistId = :artistId AND dataYear = :dataYear;

getStampRallyNotes:
SELECT * FROM stampRallyNotes
WHERE stampRallyId = :stampRallyId;

updateArtistNotes:
INSERT INTO artistNotes(artistId, dataYear, notes, generation, updatedAt)
VALUES(:artistId, :dataYear, :notes, :generation, :updatedAt)
ON CONFLICT(artistId, dataYear)
DO UPDATE SET notes = excluded.notes;

updateStampRallyNotes:
INSERT INTO stampRallyNotes(stampRallyId, notes, generation, updatedAt)
VALUES(:stampRallyId, :notes, :generation, :updatedAt)
ON CONFLICT(stampRallyId)
DO UPDATE SET notes = excluded.notes;
