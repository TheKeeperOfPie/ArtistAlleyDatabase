getSeries:
SELECT rowid AS rowid, * FROM seriesEntry;

getSeriesAndImageIds:
SELECT id, aniListId, openLibraryId, steamId, steamImagePath, tmdbId, tmdbType, wikipediaId FROM seriesEntry;

getSeriesById:
SELECT rowid AS rowid, * FROM seriesEntry
WHERE id = :id;

getSeriesByIdWithUserData:
SELECT seriesEntry.rowid AS rowid, seriesEntry.*, seriesUserEntry.favorite FROM seriesEntry
LEFT OUTER JOIN seriesUserEntry
ON seriesEntry.uuid = seriesUserEntry.seriesId
WHERE id = :id;

getSeriesByIds:
SELECT seriesEntry.* FROM seriesEntry
WHERE id IN :ids;

getSeriesByIdsWithUserData:
SELECT seriesEntry.rowid AS rowid, seriesEntry.*, seriesUserEntry.favorite FROM seriesEntry
LEFT OUTER JOIN seriesUserEntry
ON seriesEntry.uuid = seriesUserEntry.seriesId
WHERE id IN :ids;

getSeriesTitles:
SELECT id, titlePreferred, titleEnglish, titleRomaji, titleNative FROM seriesEntry;

getBoothsBySeriesId:
SELECT artistEntry.booth FROM artistSeriesConnection
INNER JOIN artistEntry ON (artistSeriesConnection.artistRowId = artistEntry.rowid)
INNER JOIN seriesEntry ON (artistSeriesConnection.seriesRowId = seriesEntry.rowid)
WHERE artistEntry.dataYear = :dataYear
AND seriesEntry.id = :seriesId
AND (artistSeriesConnection.yearFlags & :yearFlag) != 0;

getRallyCount:
SELECT COUNT(*) FROM stampRallySeriesConnection
WHERE dataYear = :dataYear AND seriesId = :seriesId;

getSeriesChangelog:
SELECT * FROM seriesEntryChangelog;
