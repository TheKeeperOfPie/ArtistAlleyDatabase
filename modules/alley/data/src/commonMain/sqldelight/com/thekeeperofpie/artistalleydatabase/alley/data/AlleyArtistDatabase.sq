import kotlin.String;
import kotlin.collections.List;
import kotlin.collections.Set;
import kotlin.uuid.Uuid;
import com.thekeeperofpie.artistalleydatabase.shared.alley.data.DataYear;
import com.thekeeperofpie.artistalleydatabase.shared.alley.data.SeriesSource;
import com.thekeeperofpie.artistalleydatabase.shared.alley.data.TmdbType;

CREATE TABLE
    IF NOT EXISTS artistSeriesConnection (
        artistRowId INTEGER NOT NULL,
        seriesRowId INTEGER NOT NULL,
        yearFlags INTEGER NOT NULL DEFAULT 0,
        PRIMARY KEY (artistRowId, seriesRowId)
    ) WITHOUT ROWID;

CREATE INDEX IF NOT EXISTS index_artistSeriesConnection_seriesRowId ON artistSeriesConnection (seriesRowId);

CREATE TABLE
    IF NOT EXISTS artistMerchConnection (
        artistRowId INTEGER NOT NULL,
        merchId TEXT NOT NULL,
        yearFlags INTEGER NOT NULL DEFAULT 0,
        PRIMARY KEY (artistRowId, merchId)
    ) WITHOUT ROWID;

CREATE INDEX IF NOT EXISTS index_artistMerchConnection_merchId ON artistMerchConnection (merchId);

CREATE TABLE
    IF NOT EXISTS stampRallyArtistConnection (
        stampRallyRowId INTEGER NOT NULL,
        artistRowId INTEGER NOT NULL,
        PRIMARY KEY (stampRallyRowId, artistRowId)
    ) WITHOUT ROWID;

CREATE INDEX IF NOT EXISTS index_stampRallyArtistConnection_artistRowId ON stampRallyArtistConnection (artistRowId);

CREATE TABLE
    IF NOT EXISTS stampRallySeriesConnection (
        stampRallyRowId INTEGER NOT NULL,
        seriesId TEXT NOT NULL,
        dataYear TEXT AS DataYear NOT NULL,
        PRIMARY KEY (stampRallyRowId, seriesId)
    ) WITHOUT ROWID;

CREATE INDEX IF NOT EXISTS index_stampRallySeriesConnection_seriesId ON stampRallySeriesConnection (seriesId);

CREATE TABLE
    IF NOT EXISTS stampRallyMerchConnection (
        stampRallyRowId INTEGER NOT NULL,
        merchId TEXT NOT NULL,
        dataYear TEXT AS DataYear NOT NULL,
        PRIMARY KEY (stampRallyRowId, merchId)
    ) WITHOUT ROWID;

CREATE INDEX IF NOT EXISTS index_stampRallyMerchConnection_merchId ON stampRallyMerchConnection (merchId);

CREATE TABLE
    IF NOT EXISTS stampRallyPrizeMerchConnection (
        stampRallyRowId INTEGER NOT NULL,
        merchId TEXT NOT NULL,
        dataYear TEXT AS DataYear NOT NULL,
        PRIMARY KEY (stampRallyRowId, merchId)
    ) WITHOUT ROWID;

CREATE INDEX IF NOT EXISTS index_stampRallyPrizeMerchConnection_merchId ON stampRallyPrizeMerchConnection (merchId);

CREATE TABLE
    IF NOT EXISTS seriesEntry (
        id TEXT NOT NULL COLLATE NOCASE,
        uuid TEXT NOT NULL,
        notes TEXT,
        aniListId INTEGER,
        aniListType TEXT,
        wikipediaId INTEGER,
        tmdbId TEXT DEFAULT NULL,
        tmdbType TEXT AS TmdbType DEFAULT NULL,
        steamId TEXT DEFAULT NULL,
        steamImagePath TEXT DEFAULT NULL,
        openLibraryId TEXT DEFAULT NULL,
        source TEXT AS SeriesSource,
        titlePreferred TEXT NOT NULL COLLATE NOCASE,
        titleEnglish TEXT NOT NULL COLLATE NOCASE,
        titleRomaji TEXT NOT NULL COLLATE NOCASE,
        titleNative TEXT NOT NULL COLLATE NOCASE,
        synonyms TEXT AS List<String>,
        link TEXT,
        inferred2024 INTEGER NOT NULL DEFAULT 0,
        inferred2025 INTEGER NOT NULL DEFAULT 0,
        inferredAnimeExpo2026 INTEGER NOT NULL DEFAULT 0,
        inferredAnimeNyc2024 INTEGER NOT NULL DEFAULT 0,
        inferredAnimeNyc2025 INTEGER NOT NULL DEFAULT 0,
        inferredAnimeNyc2026 INTEGER NOT NULL DEFAULT 0,
        confirmed2024 INTEGER NOT NULL DEFAULT 0,
        confirmed2025 INTEGER NOT NULL DEFAULT 0,
        confirmedAnimeExpo2026 INTEGER NOT NULL DEFAULT 0,
        confirmedAnimeNyc2024 INTEGER NOT NULL DEFAULT 0,
        confirmedAnimeNyc2025 INTEGER NOT NULL DEFAULT 0,
        confirmedAnimeNyc2026 INTEGER NOT NULL DEFAULT 0,
        PRIMARY KEY (id)
    );

CREATE VIRTUAL TABLE IF NOT EXISTS seriesEntry_fts USING FTS5 (
    id,
    uuid,
    aniListType,
    source,
    titlePreferred,
    titleEnglish,
    titleRomaji,
    titleNative,
    synonyms,
    inferred2024,
    inferred2025,
    inferredAnimeExpo2026,
    inferredAnimeNyc2024,
    inferredAnimeNyc2025,
    inferredAnimeNyc2026,
    confirmed2024,
    confirmed2025,
    confirmedAnimeExpo2026,
    confirmedAnimeNyc2024,
    confirmedAnimeNyc2025,
    confirmedAnimeNyc2026,
    content=seriesEntry,
    tokenize="unicode61 remove_diacritics 2"
);

CREATE TABLE
    IF NOT EXISTS seriesEntryChangelog (
        date TEXT NOT NULL,
        seriesIds TEXT AS Set<String>,
        PRIMARY KEY (date)
    );

CREATE TABLE
    IF NOT EXISTS merchEntry (
        name TEXT NOT NULL,
        uuid TEXT NOT NULL,
        notes TEXT,
        categories TEXT,
        yearFlags INTEGER NOT NULL DEFAULT 0,
        PRIMARY KEY (name)
    );

CREATE VIRTUAL TABLE IF NOT EXISTS merchEntry_fts USING FTS5 (
    name,
    uuid,
    notes,
    yearFlags,
    content=merchEntry,
    tokenize="unicode61 remove_diacritics 2"
);

CREATE TABLE
    IF NOT EXISTS merchEntryChangelog (
        date TEXT NOT NULL,
        merchIds TEXT AS Set<String>,
        PRIMARY KEY (date)
    );
