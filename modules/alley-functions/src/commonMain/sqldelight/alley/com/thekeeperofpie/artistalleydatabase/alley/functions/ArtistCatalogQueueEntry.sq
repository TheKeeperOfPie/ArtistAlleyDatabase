getCatalogEntry:
SELECT * FROM artistCatalogQueueEntry
WHERE dataYear = :dataYear AND artistId = :artistId;

getCatalogEntries:
SELECT * FROM artistCatalogQueueEntry
WHERE dataYear = :dataYear;

insertCatalogEntry:
INSERT OR REPLACE INTO artistCatalogQueueEntry
VALUES ?;

deleteCatalogEntry:
DELETE FROM artistCatalogQueueEntry
WHERE dataYear = :dataYear AND artistId = :artistId;

consumeCatalogEntry:
DELETE FROM artistCatalogQueueEntry
WHERE dataYear = :dataYear AND artistId = :artistId AND link = :link;
