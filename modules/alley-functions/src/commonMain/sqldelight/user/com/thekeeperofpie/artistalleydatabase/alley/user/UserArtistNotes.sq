insertUserArtistNotes:
INSERT INTO userArtistNotes
VALUES ?
ON CONFLICT(userId, dataYear, artistId) DO UPDATE SET
    notes = IIF(excluded.updatedAt > updatedAt, IFNULL(excluded.notes, notes), notes),
    updatedAt = MAX(excluded.updatedAt, updatedAt),
    generation = excluded.generation;

getChangesBetween:
SELECT generation, dataYear, artistId, notes, updatedAt FROM userArtistNotes
WHERE (
    userId = :userId AND
    generation > :lowerGeneration AND
    generation <= :upperGeneration
);
