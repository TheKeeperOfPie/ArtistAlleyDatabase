getAllUserArtists:
SELECT * FROM userArtist
WHERE userId = :userId;

getAllUserArtistNotes:
SELECT * FROM userArtistNotes
WHERE userId = :userId;

getAllUserStampRallies:
SELECT * FROM userStampRally
WHERE userId = :userId;

getAllUserStampRallyNotes:
SELECT * FROM userStampRallyNotes
WHERE userId = :userId;

getAllUserSeries:
SELECT * FROM userSeries
WHERE userId = :userId;

getAllUserMerch:
SELECT * FROM userMerch
WHERE userId = :userId;
