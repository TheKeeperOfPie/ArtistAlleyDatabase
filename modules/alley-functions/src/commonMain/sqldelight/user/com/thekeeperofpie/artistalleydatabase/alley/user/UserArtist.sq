insertUserArtist:
INSERT INTO userArtist
VALUES ?
ON CONFLICT(userId, dataYear, artistId) DO UPDATE SET
    favorite = IIF(excluded.updatedAt > updatedAt, IFNULL(excluded.favorite, favorite), favorite),
    ignored = IIF(excluded.updatedAt > updatedAt, IFNULL(excluded.ignored, ignored), ignored),
    updatedAt = MAX(excluded.updatedAt, updatedAt),
    generation = excluded.generation;

getChangesBetween:
SELECT generation, dataYear, artistId, favorite, ignored, updatedAt FROM userArtist
WHERE (
    userId = :userId AND
    generation > :lowerGeneration AND
    generation <= :upperGeneration
);
